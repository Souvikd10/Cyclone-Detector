1# =============================================================================
# Cyclone Prediction System — Environment Variables Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# =============================================================================

# ── PostgreSQL + PostGIS ──
POSTGRES_USER=cyclone
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=cyclone_db
DB_PORT=5432

# ── MinIO ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ── MLflow ──
MLFLOW_PORT=5001
# MLFLOW_TRACKING_URI=http://localhost:5001

# ── Prefect ──
PREFECT_PORT=4200

# ── FastAPI Backend ──
API_PORT=8000
ENVIRONMENT=development

# ── AI/ML & Satellite Credentials ──
# MOSDAC Satellite Data Portal (https://mosdac.gov.in)
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Copernicus Climate Data Store (ERA5)
ERA5_API_KEY=
