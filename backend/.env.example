# ── Application ──
APP_NAME=SIH-2K26 Cyclone Prediction API
ENVIRONMENT=development
DEBUG=true

# ── Database ──
# Works with PostgreSQL in Docker or local PostGIS.
# If PostgreSQL is not reachable, the API automatically falls back to the in-memory mock store.
DATABASE_URL=postgresql+psycopg_async://cyclone:cyclone_secret@localhost:5432/cyclone_db
DATABASE_URL_SYNC=postgresql+psycopg://cyclone:cyclone_secret@localhost:5432/cyclone_db

# ── MinIO ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ── MLflow ──
MLFLOW_TRACKING_URI=http://localhost:5001

# ── Prefect ──
PREFECT_API_URL=http://localhost:4200/api

# ── Gemini AI ──
# Required for Live multimodal audio WebSocket session & conversation AI. Never expose in frontend code.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_CHAT_MODEL=models/gemini-3.6-flash
